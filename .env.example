# orca-web environment — copy to .env if you need local overrides.
# Everything below is OPTIONAL: orca-web is a browser-only client and needs
# no server-side configuration to run.

# Demo/dev only: advertised by the mock server for local pairing.
# PORT=6768
# MOCK_AUTH_TOKEN=mock-device-token
# MOCK_REPO_COUNT=2
# MOCK_WORKTREE_COUNT=3
# MOCK_RPC_DELAY_MS=0
